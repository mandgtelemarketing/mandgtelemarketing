# Resend API key for the Request a Call form (server only).
RESEND_API_KEY=
# Sender on a Resend-verified domain, e.g. "M&G Telemarketing <hello@mandgtelemarketingllc.com>"
CONTACT_FROM=
# Where form requests go. Defaults to mandgtelemarketing@gmail.com.
CONTACT_TO=
# Local testing only: set to 1 to log emails instead of sending them.
CONTACT_DRY_RUN=
